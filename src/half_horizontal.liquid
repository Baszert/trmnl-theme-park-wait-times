{%- if qc.status == "open" -%}
<div class="layout layout--col layout--stretch">
  <div class="flex flex--row flex--stretch portrait:flex--col portrait:flex--stretch gap--large w--full h--full">
    <div class="w--64 lg:w--80 portrait:w--full no-shrink flex flex--col flex--stretch-x gap--small">
      {{ avg_item | replace: 'value--xlarge lg:value--xxlarge', 'value--large lg:value--xlarge' }}
      {{ crowd_bar }}
    </div>
    <div class="grow">{{ rides_table | replace: 'class="table ', 'class="table table--small table--condensed lg:table--base ' }}</div>
  </div>
</div>
{{ title_bar }}
{%- else -%}
{{ empty_screen }}
{%- endif -%}
