{%- if qc.status == "open" -%}
<div class="layout layout--col layout--stretch">
<div class="flex flex--col flex--stretch-x gap--small w--full h--full">
  <div class="flex flex--row flex--between flex--center-y w--full">
    {{ avg_item }}
  </div>
  {{ crowd_bar }}
  <div class="grow w--full">{{ rides_table | replace: 'class="table ', 'class="table table--small table--condensed lg:table--base ' | replace: 'lg:label--large" data-clamp', 'lg:label--large lg:portrait:label--base" data-clamp' }}</div>
</div>
</div>
{{ title_bar | replace: 'Powered by Queue-Times.com', 'Queue-Times.com' | replace: 'class="instance"', 'class="instance portrait:hidden lg:portrait:visible"' }}
{%- else -%}
{{ empty_screen }}
{%- endif -%}
