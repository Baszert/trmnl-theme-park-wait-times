{%- comment -%} /Sprites {%- endcomment -%}
<style>
  /* Pixel guests: plain class selectors, because the copies made by <use> do not match ancestor selectors.
     1-bit draws grays as dot patterns, the 4-bit X uses real grays. */
  .qc-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  .qk { fill: #000; } .qw { fill: #fff; }
  .qd { fill: var(--qc-d, url(#qcg-d)); } .qg { fill: var(--qc-g, url(#qcg-g)); } .ql { fill: var(--qc-l, url(#qcg-l)); }
  .qpd { fill: var(--qc-d, url(#qcp-d)); } .qpg { fill: var(--qc-g, url(#qcp-g)); } .qpl { fill: var(--qc-l, url(#qcp-l)); }
  .screen--4bit { --qc-d: #4a4a4a; --qc-g: #8c8c8c; --qc-l: #cfcfcf; }
  /* Speech bubble: the framework outline plus a little tail pointing at the guest. */
  .qc-say { --b: 2px; position: relative; background: #fff; border: var(--b) solid #000; border-radius: 8px; }
  .screen--lg .qc-say { --b: 3px; border-radius: 12px; }
  .qc-say::before { content: ""; position: absolute; left: calc(-6px - var(--b)); top: 50%; width: 10px; height: 10px; margin-top: -5px; background: #fff; border-left: var(--b) solid #000; border-bottom: var(--b) solid #000; transform: rotate(45deg); }
  .screen--lg .qc-say::before { left: -11px; width: 14px; height: 14px; margin-top: -7px; }
</style>
{%- assign off = trmnl.user.utc_offset | default: 0 -%}
{%- assign park_raw = trmnl.plugin_settings.custom_fields_values.park | default: "160~Efteling~30713cf6-69a9-47c9-a505-52bb965f01be" -%}
{%- assign park_parts = park_raw | split: "~" -%}
{%- assign park_name = park_parts[1] -%}
{%- assign upd_l = qc.updated | plus: off -%}

{%- comment -%} Title bar icon: a coaster hill. {%- endcomment -%}
{%- capture svg_logo -%}<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2" stroke-linejoin="round"><path d="M2 19C5 3 8 3 11 13s6-6 11-2"/><path d="M2 21h20M6 21v-9M11 21v-7M17 21v-9"/></svg>{%- endcapture -%}
{%- capture title_bar -%}
<div class="title_bar">
  <img class="image image-stroke" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" alt="">
  <span class="title">{{ park_name }}</span>
  <span class="instance">Powered by Queue-Times.com</span>
</div>
{%- endcapture -%}

{%- comment -%} One guest, and the line of guests for a ride (one per 12 minutes, at most 5). {%- endcomment -%}
{%- capture guest -%}<svg class="w--8 h--10 lg:w--12 lg:h--16 no-shrink" viewBox="0 0 13 17"><use href="#qc-g1"/></svg>{%- endcapture -%}

{%- comment -%} The rides, longest queue first. The framework hides the rows that do not fit and adds "and X more". {%- endcomment -%}
{%- capture rides_table -%}
<table class="table w--full" data-table-limit="true" data-table-overflow-counter="false">
  <thead>
    <tr>
      <th><span class="title title--small lg:title">Ride</span></th>
      <th><span class="title title--small lg:title">Queue</span></th>
      <th class="text--right"><span class="title title--small lg:title">Min</span></th>
    </tr>
  </thead>
  <tbody>
    {%- for r in qc.top -%}
    <tr>
      <td><span class="label lg:label--large" data-clamp="1">{{ r.n }}</span></td>
      <td>{%- if r.q > 0 -%}<span class="flex flex--row flex--left gap--none">{%- for i in (1..r.q) -%}{%- assign gi = i | times: 3 | plus: r.rank | modulo: 8 | plus: 1 -%}<svg class="w--3 h--4 lg:w--5 lg:h--6 no-shrink" viewBox="0 0 13 17"><use href="#qc-g{{ gi }}"/></svg>{%- endfor -%}</span>{%- else -%}<span class="label label--small lg:label">walk-on</span>{%- endif -%}</td>
      <td class="text--right"><span class="label lg:label--large value--tnums{% if r.heat == 'hot' %} label--inverted{% elsif r.heat == 'warm' %} label--outline{% endif %}">{{ r.w }}</span></td>
    </tr>
    {%- endfor -%}
  </tbody>
</table>
{%- endcapture -%}

{%- comment -%} Crowd level and the day as framework progress bars. {%- endcomment -%}
{%- capture crowd_bar -%}
<div class="progress-bar progress-bar--large w--full">
  <div class="content"><span class="label lg:label--large">Crowd: {{ qc.level }}</span><span class="label lg:label--large">{{ qc.open }}/{{ qc.total }} rides open</span></div>
  <div class="track"><div class="fill" style="width: {{ qc.seg | times: 10 }}%"></div></div>
</div>
{%- endcapture -%}
{%- capture day_bar -%}
{%- if qc.day -%}
<div class="progress-bar progress-bar--small lg:progress-bar w--full">
  <div class="content"><span class="label lg:label--large">{{ qc.day.from }} - {{ qc.day.to }}</span><span class="label lg:label--large">{{ qc.day.left }}</span></div>
  <div class="track"><div class="fill" style="width: {{ qc.day.pct }}%"></div></div>
</div>
{%- endif -%}
{%- endcapture -%}
{%- capture avg_item -%}
<div class="item">
  <div class="meta"></div>
  <div class="content">
    <span class="value value--xlarge lg:value--xxlarge value--tnums">{{ qc.avg }}</span>
    <span class="label lg:label--large">min average wait</span>
  </div>
</div>
{%- endcapture -%}

{%- comment -%} The shortest line in the park right now. {%- endcomment -%}
{%- capture tip_item -%}
{%- if qc.tip -%}
<div class="item">
  <div class="meta"></div>
  <div class="content">
    <span class="label label--gray lg:label--large">Shortest line now</span>
    <span class="title title--small lg:title" data-clamp="1">{{ qc.tip.n }}</span>
    <span class="label lg:label--large">{% if qc.tip.w == 0 %}Walk right on{% else %}{{ qc.tip.w }} min wait{% endif %}</span>
  </div>
</div>
{%- endif -%}
{%- endcapture -%}

{%- comment -%} A guest in the line says what they think, in a speech bubble. {%- endcomment -%}
{%- capture guest_says -%}
<div class="flex flex--row flex--left flex--center-y gap w--full">{{ guest }}<div class="qc-say grow p--2 lg:p--3"><span class="description lg:description--large" data-clamp="3">{{ qc.thought }}</span></div></div>
{%- endcapture -%}

{%- comment -%} Closed or offline: the gate stays shut. {%- endcomment -%}
{%- capture empty_screen -%}
<div class="layout layout--col layout--center gap--medium">
  <svg class="w--16 h--10 lg:w--32 lg:h--20" viewBox="0 0 24 15"><use href="#qc-gate"/></svg>
  {%- if qc.status == "closed" -%}
  <span class="title lg:title--large text--center">The park is closed</span>
  <span class="description lg:description--large text--center" data-clamp="3">{% if qc.reason == "down" %}Every ride is closed right now. Waits are back when the first one opens.{% elsif qc.opens != "" %}The rides are asleep. The gates open {{ qc.opens }}.{% else %}The rides are asleep. Waits show up when the gates open.{% endif %}</span>
  {%- else -%}
  <span class="title lg:title--large text--center">Lost signal</span>
  <span class="description lg:description--large text--center" data-clamp="3">The queue board did not answer. Trying again on the next refresh.</span>
  {%- endif -%}
  <div class="flex flex--row flex--center-y gap">{{ guest }}<div class="qc-say p--2 lg:p--3"><span class="label lg:label--large">{% if qc.status == "closed" %}See you at opening time!{% else %}The operator went for coffee...{% endif %}</span></div></div>
</div>
{{ title_bar }}
{%- endcapture -%}
