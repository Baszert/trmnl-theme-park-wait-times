{%- if qc.status == "open" -%}
<div class="layout layout--col layout--stretch">
  <div class="flex flex--row flex--stretch portrait:flex--col portrait:flex--stretch gap--large w--full h--full">
    <div class="w--64 lg:w--80 portrait:w--full no-shrink flex flex--col flex--stretch-x gap--medium">
      {{ avg_item }}
      {{ crowd_bar }}
      {{ day_bar }}
      <span class="label lg:label--large">{{ qc.open }} of {{ qc.total }} rides open · {{ upd_l | date: "%H:%M" }}</span>
      <div class="divider"></div>
      <div class="flex flex--row flex--left flex--top gap--small">{{ guest }}<span class="description lg:description--large" data-clamp="4">"{{ qc.thought }}"</span></div>
    </div>
    <div class="grow">{{ rides_table }}</div>
  </div>
</div>
{{ title_bar }}
{%- else -%}
{{ empty_screen }}
{%- endif -%}
