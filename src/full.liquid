{%- if qc.status == "open" -%}
<div class="layout layout--col layout--stretch">
  <div class="flex flex--row flex--stretch portrait:flex--col portrait:flex--stretch gap--large w--full h--full">
    <div class="w--64 lg:w--80 portrait:w--full no-shrink flex flex--col flex--stretch-x gap--medium">
      {{ avg_item }}
      {{ crowd_bar }}
      {{ day_bar }}
      <div class="divider"></div>
      {{ tip_item }}
      {{ guest_says }}
    </div>
    <div class="grow">{{ rides_table }}</div>
  </div>
</div>
{{ title_bar }}
{%- else -%}
{{ empty_screen }}
{%- endif -%}
